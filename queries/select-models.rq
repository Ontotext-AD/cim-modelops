# List FullModel / DifferenceSet datasets written to `cim-modelops`.
# Used by the Models tab.

PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dcatcim: <https://cim4.eu/ns/dcatcim#>
PREFIX dct: <http://purl.org/dc/terms/>

SELECT ?g ?model ?kind ?version ?issued ?title ?desc ?prev ?fwd ?rev WHERE {
  GRAPH ?g {
    {
      ?model a dcat:Dataset .
      BIND ("FullModel" AS ?kind)
    }
    UNION
    {
      ?model a dcatcim:DifferenceSet .
      BIND ("DifferenceSet" AS ?kind)
    }
    OPTIONAL { ?model dcat:version ?version }
    OPTIONAL { ?model dct:issued ?issued }
    OPTIONAL { ?model dct:title ?title }
    OPTIONAL { ?model dct:description ?desc }
    OPTIONAL { ?model dcat:previousVersion ?prev }
    # A DifferenceSet keeps its changes in separate graphs; the TriG download includes them.
    OPTIONAL { ?model dcatcim:forwardDifferenceSet ?fwd }
    OPTIONAL { ?model dcatcim:reverseDifferenceSet ?rev }
  }
}
ORDER BY DESC(?issued) ?kind ?model
